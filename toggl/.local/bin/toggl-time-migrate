#!/bin/bash
# toggl-time-migrate — import legacy <repo>/.toggl-time JSONL files into the
# central state DB at ~/.local/state/toggl/state.db, optionally deleting the
# originals afterwards.
#
# Usage: toggl-time-migrate [--root DIR]... [--delete] [--dry-run]
#   --root DIR    Roots to scan for .toggl-time files. Repeatable.
#                 Default: $HOME/src
#   --delete      Remove each .toggl-time after a *fully successful* import
#                 (no skipped lines). Files with any skipped line are kept.
#   --dry-run     Print intended actions; do not write the DB and do not
#                 delete anything.
#
# Each .toggl-time line is keyed in the DB by `realpath` of the file's
# parent directory — matching the canonical-path convention used by
# toggl-set, toggl-time, and the tmux script.
#
# Per-file transactions: each .toggl-time is imported in a single SQL
# transaction. A partial-failure inside one file does NOT roll back rows
# imported from prior files.
#
# Exit codes:
#   0  Success (even when nothing was imported).
#   1  Argument error.
#
# Required tools: bash, jq, find, realpath, sqlite3.

set -euo pipefail

# shellcheck source=./toggl-state.lib.sh
source "$(dirname "$(realpath "$0")")/toggl-state.lib.sh"

roots=()
delete=0
dry_run=0

while (($#)); do
    case "$1" in
        --root)
            shift
            if [[ -z "${1:-}" ]]; then
                echo "toggl-time-migrate: --root requires a directory" >&2
                exit 1
            fi
            roots+=("$1")
            shift
            ;;
        --delete)
            delete=1
            shift
            ;;
        --dry-run)
            dry_run=1
            shift
            ;;
        -h|--help)
            sed -n '2,25p' "$0"
            exit 0
            ;;
        *)
            echo "toggl-time-migrate: unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

if (( ${#roots[@]} == 0 )); then
    roots=("$HOME/src")
fi

# Initialize the DB unless we're in dry-run.
if (( ! dry_run )); then
    toggl_state_init
fi

imported_rows=0
skipped_rows=0
files_deleted=0

# import_file <path> — process one .toggl-time. Sets file-local counters
# imported_in_file / skipped_in_file via name reference for the caller.
import_file() {
    local file=$1
    local key
    key=$(realpath "$(dirname "$file")")

    local imported_in_file=0
    local skipped_in_file=0
    local line_no=0
    local sql_lines=()

    while IFS= read -r raw || [[ -n "$raw" ]]; do
        ((line_no++)) || true
        # Skip blank lines silently (matches parseHeartbeats).
        [[ -z "${raw// }" ]] && continue

        # Validate JSON.
        local parsed
        if ! parsed=$(jq -c . <<<"$raw" 2>/dev/null); then
            echo "toggl-time-migrate: $file: line $line_no: invalid JSON, skipping" >&2
            ((skipped_in_file++)) || true
            continue
        fi

        # Pull required fields.
        local ts event trigger session_id client project_id project_name task details
        ts=$(jq -r '.ts // empty'           <<<"$parsed")
        event=$(jq -r '.event // empty'     <<<"$parsed")
        trigger=$(jq -r '.trigger // empty' <<<"$parsed")
        session_id=$(jq -r '.session_id // ""' <<<"$parsed")
        client=$(jq -r '.client_name // empty' <<<"$parsed")
        project_id=$(jq -r '.project_id // empty' <<<"$parsed")
        project_name=$(jq -r '.project_name // empty' <<<"$parsed")
        task=$(jq -r '.task // empty' <<<"$parsed")
        details=$(jq -c '.details // empty' <<<"$parsed")

        # Validate required fields. Treat empty string as missing.
        if [[ -z "$ts" || -z "$event" || -z "$trigger" || \
              -z "$client" || -z "$project_id" || -z "$project_name" || -z "$task" ]]; then
            echo "toggl-time-migrate: $file: line $line_no: missing required field, skipping" >&2
            ((skipped_in_file++)) || true
            continue
        fi
        if [[ "$event" != "start" && "$event" != "pause" ]]; then
            echo "toggl-time-migrate: $file: line $line_no: invalid event '$event', skipping" >&2
            ((skipped_in_file++)) || true
            continue
        fi
        if ! [[ "$project_id" =~ ^[0-9]+$ ]]; then
            echo "toggl-time-migrate: $file: line $line_no: non-numeric project_id, skipping" >&2
            ((skipped_in_file++)) || true
            continue
        fi

        # Build the VALUES tuple. We accumulate all rows for this file and
        # commit them in a single transaction below.
        local session_sql details_sql
        if [[ -z "$session_id" ]]; then
            session_sql=NULL
        else
            session_sql=$(sql_quote "$session_id")
        fi
        if [[ -z "$details" ]]; then
            details_sql=NULL
        else
            details_sql=$(sql_quote "$details")
        fi

        sql_lines+=(
            "($(sql_quote "$ts"), $(sql_quote "$event"), $(sql_quote "$trigger"), $session_sql, $(sql_quote "$key"), $(sql_quote "$client"), $project_id, $(sql_quote "$project_name"), $(sql_quote "$task"), $details_sql)"
        )
        ((imported_in_file++)) || true
    done <"$file"

    # One-line per-file summary.
    printf 'import %s\n  path=%s rows=%d skipped=%d\n' \
        "$file" "$key" "$imported_in_file" "$skipped_in_file"

    if (( dry_run )); then
        imported_rows=$((imported_rows + imported_in_file))
        skipped_rows=$((skipped_rows + skipped_in_file))
        return 0
    fi

    # Commit in one transaction per file. Empty file → no-op.
    if (( imported_in_file > 0 )); then
        local sql
        sql="BEGIN;\nINSERT INTO toggl_heartbeats"
        sql+=" (ts, event, trigger, session_id, worktree_path, client_name, project_id, project_name, task, details) VALUES\n"
        local first=1
        local row
        for row in "${sql_lines[@]}"; do
            if (( first )); then
                sql+="$row"
                first=0
            else
                sql+=",\n$row"
            fi
        done
        sql+=";\nCOMMIT;"
        printf '%b\n' "$sql" | sqlite3 "$TOGGL_STATE_DB"
    fi

    imported_rows=$((imported_rows + imported_in_file))
    skipped_rows=$((skipped_rows + skipped_in_file))

    # --delete only removes files that imported cleanly (no skipped lines).
    if (( delete )) && (( skipped_in_file == 0 )); then
        rm -f -- "$file"
        ((files_deleted++)) || true
    fi
}

# Walk each root.
for root in "${roots[@]}"; do
    if [[ ! -d "$root" ]]; then
        echo "toggl-time-migrate: root $root not found, skipping" >&2
        continue
    fi
    while IFS= read -r -d '' f; do
        import_file "$f"
    done < <(find "$root" -type f -name .toggl-time -print0 2>/dev/null)
done

echo
if (( dry_run )); then
    echo "summary (dry-run): imported_rows=$imported_rows skipped_rows=$skipped_rows files_deleted=0"
else
    echo "summary: imported_rows=$imported_rows skipped_rows=$skipped_rows files_deleted=$files_deleted"
fi
