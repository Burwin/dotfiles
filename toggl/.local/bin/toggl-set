#!/bin/bash
# toggl-set — interactively pick an active Toggl project and write
# .toggl at the git repo root with project_id, project_name, and client_name.
#
# Usage: toggl-set [query]
#   With no query: lists all active projects for selection.
#   With a query: case-insensitive substring filter on project name OR client name.
#                 If exactly one project matches, it is auto-selected and written.
#                 If no projects match, falls back to the full list.
#
#   When `.toggl` already exists, the current project is promoted to index 1 of
#   any rendered table — highlighted green when it's still in the filter result,
#   red when it isn't. Color emission honors $NO_COLOR / $FORCE_COLOR / TTY.
#
# Data source: ~/src/bamboo/tools/src/toggl/toggl.db (populated by `toggl-pull`).
# If a desired project is missing, run `toggl-pull` first to refresh the DB.
#
# Required tools: bash, git, sqlite3, jq, awk.

set -euo pipefail

DB="$HOME/src/bamboo/tools/src/toggl/toggl.db"
query="$*"

# 1. Locate git repo root
if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "Error: not inside a git repository" >&2
    exit 1
fi

# 2. Verify the local Toggl DB exists
if [[ ! -f "$DB" ]]; then
    echo "Error: $DB not found. Run 'toggl-pull' first." >&2
    exit 1
fi

# 2b. Color mode: emit ANSI iff stdout is a TTY or FORCE_COLOR is non-empty,
#     and NO_COLOR is empty (https://no-color.org/).
color=0
if [[ -z "${NO_COLOR:-}" ]]; then
    if [[ -n "${FORCE_COLOR:-}" ]] || [[ -t 1 ]]; then
        color=1
    fi
fi

# 3. Load active projects (id<TAB>name<TAB>client_name) into a bash array.
#    Empty string in column 3 means client_name was NULL in the DB.
mapfile -t projects < <(
    sqlite3 -separator $'\t' "$DB" \
        "SELECT id, name, COALESCE(client_name, '')
         FROM toggl_projects
         WHERE active = 1
         ORDER BY client_name, name"
)

if (( ${#projects[@]} == 0 )); then
    echo "No active projects found in DB. Run 'toggl-pull' to refresh." >&2
    exit 1
fi

# 3b. Apply substring filter if a query was supplied. Case-insensitive match
#     against the name (column 2) or client_name (column 3) only — id is excluded.
had_filter_match=0
if [[ -n "$query" ]]; then
    mapfile -t filtered < <(
        printf '%s\n' "${projects[@]}" |
            awk -F'\t' -v q="${query,,}" \
                'index(tolower($2), q) || index(tolower($3), q)'
    )
    if (( ${#filtered[@]} > 0 )); then
        projects=("${filtered[@]}")
        had_filter_match=1
    else
        echo "No matches for '$query'; showing all projects." >&2
    fi
fi

# 4. Show current .toggl contents and capture for promotion in step 5b.
current_id=""
current_name=""
current_client=""
current_task=""
if [[ -f "$repo_root/.toggl" ]]; then
    echo "Current $repo_root/.toggl:"
    jq . "$repo_root/.toggl" 2>/dev/null || cat "$repo_root/.toggl"
    echo
    current_id=$(jq -r '.project_id // empty' "$repo_root/.toggl" 2>/dev/null || true)
    current_name=$(jq -r '.project_name // empty' "$repo_root/.toggl" 2>/dev/null || true)
    current_client=$(jq -r '.client_name // ""' "$repo_root/.toggl" 2>/dev/null || true)
    current_task=$(jq -r '.task // ""' "$repo_root/.toggl" 2>/dev/null || true)
fi

# 5. Auto-select when the substring filter narrowed to exactly one project.
write_toggl() {
    local id=$1 name=$2 client=$3 task=$4
    jq -n \
        --argjson project_id "$id" \
        --arg project_name "$name" \
        --arg client_name "$client" \
        --arg task "$task" \
        '{
            project_id: $project_id,
            project_name: $project_name,
            client_name: (if $client_name == "" then null else $client_name end),
            task: (if $task == "" then null else $task end)
        }' \
        > "$repo_root/.toggl"
    echo
    echo "Wrote $repo_root/.toggl:"
    jq . "$repo_root/.toggl"
}

# prompt_task — read a task description from stdin, populating the script-level
# `task` variable. When re-selecting the same project, shows the existing task
# as a [bracket default]; an empty input keeps it. EOF cancels the operation.
prompt_task() {
    local selected_id=$1
    local p
    if [[ -n "$current_task" ]] && [[ "$selected_id" == "$current_id" ]]; then
        p="Task description [$current_task]: "
    else
        p="Task description: "
    fi
    if ! read -rp "$p" task; then
        echo
        echo "Cancelled (EOF)."
        exit 0
    fi
    if [[ -z "$task" ]] && [[ -n "$current_task" ]] && [[ "$selected_id" == "$current_id" ]]; then
        task="$current_task"
    fi
}

if (( had_filter_match )) && (( ${#projects[@]} == 1 )); then
    IFS=$'\t' read -r id name client <<<"${projects[0]}"
    task=""
    prompt_task "$id"
    write_toggl "$id" "$name" "$client" "$task"
    exit 0
fi

# 5b. Promote current project (from .toggl) to index 1 of the rendered table,
#     so it shows up first regardless of alphabetical client/name ordering.
#     current_in_set distinguishes "in filter result" (green) from "not in
#     filter result, synthesized from .toggl" (red).
current_in_set=0
if [[ -n "$current_id" ]]; then
    promoted=()
    rest=()
    for row in "${projects[@]}"; do
        IFS=$'\t' read -r rid _ _ <<<"$row"
        if [[ "$rid" == "$current_id" ]]; then
            promoted=("$row")
        else
            rest+=("$row")
        fi
    done
    if (( ${#promoted[@]} > 0 )); then
        current_in_set=1
    else
        promoted=("$current_id"$'\t'"$current_name"$'\t'"$current_client")
    fi
    projects=("${promoted[@]}" "${rest[@]:+"${rest[@]}"}")
fi

# 6. Render numbered table
printf '%4s  %-10s  %-32s  %s\n' "idx" "id" "name" "client_name"
printf '%4s  %-10s  %-32s  %s\n' "---" "----------" "--------------------------------" "-----------"

for i in "${!projects[@]}"; do
    IFS=$'\t' read -r id name client <<<"${projects[$i]}"
    esc_open=""
    esc_close=""
    if (( color )) && [[ -n "$current_id" ]] && [[ "$id" == "$current_id" ]]; then
        if (( current_in_set )); then
            esc_open=$'\033[32m'  # green: current is in filter result
        else
            esc_open=$'\033[31m'  # red: current was synthesized from .toggl
        fi
        esc_close=$'\033[0m'
    fi
    printf '%4d  %-10s  %s%-32s%s  %s%s%s\n' \
        $((i + 1)) "$id" \
        "$esc_open" "$name" "$esc_close" \
        "$esc_open" "$client" "$esc_close"
done

# 7. Prompt for selection (handle EOF/Ctrl-D cleanly under set -e)
echo
if ! read -rp "Select project [1-${#projects[@]}, empty to cancel]: " choice; then
    echo
    echo "Cancelled (EOF)."
    exit 0
fi

if [[ -z "$choice" ]]; then
    echo "Cancelled."
    exit 0
fi

if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#projects[@]} )); then
    echo "Error: invalid selection: $choice" >&2
    exit 1
fi

# 8. Extract chosen row and write
IFS=$'\t' read -r id name client <<<"${projects[$((choice - 1))]}"
task=""
prompt_task "$id"
write_toggl "$id" "$name" "$client" "$task"
