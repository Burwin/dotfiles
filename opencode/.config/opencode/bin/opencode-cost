#!/usr/bin/env bun
// opencode-cost — CLI for the opencode cost-tracker. Reports per-message
// and per-session costs from ~/.local/state/opencode-cost.db, and (Phase 4)
// reconciles the recompute against Zen's daily per-model billed totals.
//
// Design and rationale: ../../../../docs/plans/opencode-cost-tracker/PLAN.md
//
// Phase ownership of this file:
//   Phase 3 (CLI dump, tier: cheap) — `dump messages` / `dump sessions`
//     subcommands. Args forwarded to ../opencode-cost/dump.ts.
//   Phase 4 (zen reconciliation, tier: sota) — `zen-sync` and
//     `dump reconciliation` subcommands. Args forwarded to
//     ../opencode-cost/zen-sync.ts and ../opencode-cost/reconcile.ts.
//   Phase 5 / per-task PLAN Commit 2 — `import-opencode` subcommand
//     backfills `messages` from ~/.local/share/opencode/opencode.db's
//     step-finish part rows. Args forwarded to
//     ../opencode-cost/import-opencode.ts.
//
// Surface:
//
//   opencode-cost dump messages       [--since YYYY-MM-DD] [--json|--csv]
//   opencode-cost dump sessions       [--since YYYY-MM-DD] [--json|--csv]
//   opencode-cost zen-sync            [--month YYYY-MM] [--dry-run]
//   opencode-cost dump reconciliation [--month YYYY-MM] [--json|--csv|--table]
//   opencode-cost import-opencode     [--since YYYY-MM-DD] [--dry-run] [--reconcile]
//
// The DB at ~/.local/state/opencode-cost.db is the real interface. This
// CLI is convenience over `sqlite3` — use whichever tool you prefer.

import { runDumpMessages, runDumpSessions } from "../opencode-cost/dump.ts"
import { runZenSync } from "../opencode-cost/zen-sync.ts"
import { runReconciliation } from "../opencode-cost/reconcile.ts"
import { runImportOpencode } from "../opencode-cost/import-opencode.ts"

const usage = `opencode-cost — query the opencode cost-tracker DB

usage:
  opencode-cost dump messages       [--since YYYY-MM-DD] [--json|--csv]
  opencode-cost dump sessions       [--since YYYY-MM-DD] [--json|--csv]
  opencode-cost zen-sync            [--month YYYY-MM] [--dry-run]
  opencode-cost dump reconciliation [--month YYYY-MM] [--json|--csv|--table]
  opencode-cost import-opencode     [--since YYYY-MM-DD] [--dry-run] [--reconcile]

dump defaults: --json. Numeric fxp8 columns are NOT divided by 1e8 — let the
caller decide precision (jq: '.[] | .cost_recomputed_fxp8 / 1e8').

reconciliation defaults: --table (aligned columns, dollars at display).

zen-sync prerequisites (per PLAN.md §12.4):
  ~/.config/opencode/secrets/zen-session-cookie  (chmod 600; contents: 'auth=Fe26.2*…')
  ~/.config/opencode-cost/config.json            (workspace_id, key_id, tz_offset, server_id)

import-opencode reads ~/.local/share/opencode/opencode.db read-only and
backfills the messages table (INSERT OR IGNORE — plugin captures take
precedence) plus session_rollup. Use --dry-run for a no-op preview, or
--reconcile for a per-(date,model) drift summary against zen_daily_billed.

This CLI is a thin convenience layer over ~/.local/state/opencode-cost.db.
Query with sqlite3 / datasette / jq for anything beyond the canned dumps.

See dotfiles: docs/plans/opencode-cost-tracker/PLAN.md
`

const [cmd, sub, ...rest] = process.argv.slice(2)

const dispatch = async (): Promise<number> => {
  if (cmd === undefined || cmd === "-h" || cmd === "--help" || cmd === "help") {
    process.stdout.write(usage)
    return 0
  }

  if (cmd === "dump") {
    if (sub === "messages") return runDumpMessages(rest)
    if (sub === "sessions") return runDumpSessions(rest)
    if (sub === "reconciliation") return runReconciliation(rest)
    console.error(
      sub === undefined
        ? "opencode-cost: 'dump' requires a subcommand (messages|sessions|reconciliation)"
        : `opencode-cost: unknown 'dump' subcommand: ${sub}`,
    )
    process.stderr.write(usage)
    return 2
  }

  if (cmd === "zen-sync") {
    // `sub` is the first positional after `zen-sync`; pass through.
    const argv = sub === undefined ? [] : [sub, ...rest]
    return runZenSync(argv)
  }

  if (cmd === "import-opencode") {
    // Same shape as zen-sync: `sub` is the first positional after
    // the verb (e.g. `--dry-run`). Reassemble before forwarding.
    const argv = sub === undefined ? [] : [sub, ...rest]
    return runImportOpencode(argv)
  }

  console.error(`opencode-cost: unknown command: ${cmd}`)
  process.stderr.write(usage)
  return 2
}

process.exit(await dispatch())
