#!/usr/bin/env bun
// opencode-cost — CLI for the opencode cost-tracker. Reports per-message
// and per-session costs from ~/.local/state/opencode-cost.db, and (Phase 4)
// reconciles the recompute against Zen's daily per-model billed totals.
//
// Design and rationale: ../../../../docs/plans/opencode-cost-tracker/PLAN.md
//
// Phase ownership of this file:
//   Phase 3 (CLI dump, tier: cheap) — `dump messages` / `dump sessions`
//     subcommands. Args forwarded to ../opencode-cost/dump.ts.
//   Phase 4 (zen reconciliation, tier: sota) — adds `zen-sync` and
//     `dump reconciliation`. Currently print a "not yet implemented"
//     diagnostic so the help surface stays honest while documenting
//     the planned shape.
//
// Surface (after Phase 4):
//
//   opencode-cost dump messages [--since YYYY-MM-DD] [--json|--csv]
//   opencode-cost dump sessions [--since YYYY-MM-DD] [--json|--csv]
//   opencode-cost zen-sync [--month YYYY-MM]
//   opencode-cost dump reconciliation [--month YYYY-MM]
//
// The DB at ~/.local/state/opencode-cost.db is the real interface. This
// CLI is convenience over `sqlite3` — use whichever tool you prefer.

import { runDumpMessages, runDumpSessions } from "../opencode-cost/dump.ts"

const usage = `opencode-cost — query the opencode cost-tracker DB

usage:
  opencode-cost dump messages       [--since YYYY-MM-DD] [--json|--csv]
  opencode-cost dump sessions       [--since YYYY-MM-DD] [--json|--csv]
  opencode-cost zen-sync            [--month YYYY-MM]        (Phase 4 — not yet implemented)
  opencode-cost dump reconciliation [--month YYYY-MM]        (Phase 4 — not yet implemented)

Defaults: --json. Numeric fxp8 columns are NOT divided by 1e8 — let the
caller decide precision (jq: '.[] | .cost_recomputed_fxp8 / 1e8').

This CLI is a thin convenience layer over ~/.local/state/opencode-cost.db.
Query with sqlite3 / datasette / jq for anything beyond the canned dumps.

See dotfiles: docs/plans/opencode-cost-tracker/PLAN.md
`

const [cmd, sub, ...rest] = process.argv.slice(2)

const notYetImplemented = (which: string): number => {
  console.error(`opencode-cost: '${which}' is Phase 4 — not yet implemented`)
  return 2
}

const dispatch = (): number => {
  if (cmd === undefined || cmd === "-h" || cmd === "--help" || cmd === "help") {
    process.stdout.write(usage)
    return 0
  }

  if (cmd === "dump") {
    if (sub === "messages") return runDumpMessages(rest)
    if (sub === "sessions") return runDumpSessions(rest)
    if (sub === "reconciliation") return notYetImplemented("dump reconciliation")
    console.error(
      sub === undefined
        ? "opencode-cost: 'dump' requires a subcommand (messages|sessions)"
        : `opencode-cost: unknown 'dump' subcommand: ${sub}`,
    )
    process.stderr.write(usage)
    return 2
  }

  if (cmd === "zen-sync") return notYetImplemented("zen-sync")

  console.error(`opencode-cost: unknown command: ${cmd}`)
  process.stderr.write(usage)
  return 2
}

process.exit(dispatch())
