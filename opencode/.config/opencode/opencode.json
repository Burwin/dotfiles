{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": ["rules/safety.md", "rules/communication.md", "rules/no-ai-tells.md"],
  "permission": {
    "external_directory": {
      "*": "allow",
      "~/.config/opencode/secrets/**": "ask"
    }
  },
  "provider": {
    "opencode": {
      "blacklist": [
        "claude-opus-4-1",
        "claude-opus-4-5",
        "claude-opus-4-6",
        "claude-opus-4-7",
        "claude-opus-4-8",
        "claude-opus-5",
        "glm-4.6",
        "glm-4.7",
        "glm-4.7-free",
        "glm-5",
        "glm-5-free",
        "glm-5.1",
        "glm-5.2"
      ],
      "models": {
        "claude-fable-5": {
          "options": {
            "thinking": { "type": "adaptive" },
            "effort": "max"
          },
          "variants": {
            "high": {
              "thinking": { "type": "adaptive" },
              "effort": "high"
            },
            "xhigh": {
              "thinking": { "type": "adaptive" },
              "effort": "xhigh"
            },
            "max": {
              "thinking": { "type": "adaptive" },
              "effort": "max"
            }
          }
        },
        "grok-4.6": {
          "options": {
            "effort": "high"
          },
          "variants": {
            "xhigh": {
              "disabled": true
            }
          }
        }
      }
    },
    "xai": {
      "models": {
        "grok-4.6": {
          "options": {
            "effort": "high"
          },
          "variants": {
            "xhigh": {
              "disabled": true
            }
          }
        }
      }
    }
  },
  "mcp": {
    "asana": {
      "type": "remote",
      "url": "https://mcp.asana.com/v2/mcp",
      "oauth": {
        "clientId": "{file:~/.config/opencode/secrets/asana-mcp-client-id}",
        "clientSecret": "{file:~/.config/opencode/secrets/asana-mcp-client-secret}"
      }
    },
    "readai": {
      "type": "remote",
      "url": "https://api.read.ai/mcp"
    }
  }
}
